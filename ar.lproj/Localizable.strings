"Extracted %lu files into %@. %lu symbolic links in the ZIP were left out." = "استُخرجت %lu ملفات إلى %@. استُثنيت %lu روابط رمزية في ZIP.";
"No %@ container found." = "لم يُعثر على حاوية %@.";
